# ── Core ─────────────────────────────────────────────────────────────────────
X0R_ENV=development
X0R_DATABASE_URL=sqlite+aiosqlite:///./x0r.db
# Production (Postgres):
# X0R_DATABASE_URL=postgresql+asyncpg://x0r:x0r@localhost:5432/x0r

# ── LLM provider ─────────────────────────────────────────────────────────────
# "mock" needs no keys and makes the whole platform runnable offline.
# "openai_compatible" works with OpenAI, OpenRouter, Groq, Together, vLLM, Ollama.
X0R_PROVIDER=mock
X0R_OPENAI_BASE_URL=https://api.openai.com/v1
X0R_OPENAI_API_KEY=
X0R_CHAT_MODEL=gpt-4o-mini
X0R_EMBEDDING_MODEL=text-embedding-3-small
X0R_REQUEST_TIMEOUT=60

# ── Safety / limits ──────────────────────────────────────────────────────────
# Comma-separated allowlist for the http_get tool. Empty = tool disabled.
X0R_HTTP_TOOL_ALLOWLIST=
X0R_MAX_UPLOAD_BYTES=5242880

# ── Workspace creation ───────────────────────────────────────────────────────
# Required for POST /v1/workspaces. Leave empty to disable self-serve creation
# and use `x0r init` instead.
X0R_BOOTSTRAP_TOKEN=
# Comma-separated origins allowed to call the API from a browser.
X0R_CORS_ORIGINS=*

# Operator-managed tool permissions. Agents cannot expand this list.
# HTTP access additionally requires X0R_HTTP_TOOL_ALLOWLIST.
X0R_OPERATOR_TOOL_ALLOWLIST=knowledge_search,calculator
X0R_MAX_TOOL_CALLS_PER_STEP=8

# HTTP tool resource limits; HTTP remains disabled unless explicitly granted.
X0R_MAX_HTTP_RESPONSE_BYTES=262144
X0R_HTTP_TOOL_TIMEOUT=10
